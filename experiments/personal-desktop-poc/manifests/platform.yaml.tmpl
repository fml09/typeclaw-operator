apiVersion: v1
kind: Namespace
metadata:
  name: "${DESKTOP_NAMESPACE}"
  labels:
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/experimental: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: personal-desktop-gateway
  namespace: "${DESKTOP_NAMESPACE}"
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: personal-desktop-gateway
  namespace: "${DESKTOP_NAMESPACE}"
rules:
  - apiGroups: ["kubevirt.io"]
    resources: ["virtualmachines", "virtualmachineinstances"]
    verbs: ["get"]
  - apiGroups: ["subresources.kubevirt.io"]
    resources:
      - virtualmachineinstances/vnc
      - virtualmachineinstances/vnc/screenshot
    verbs: ["get"]
  - apiGroups: ["subresources.kubevirt.io"]
    resources:
      - virtualmachines/start
      - virtualmachines/stop
    verbs: ["update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: personal-desktop-gateway
  namespace: "${DESKTOP_NAMESPACE}"
subjects:
  - kind: ServiceAccount
    name: personal-desktop-gateway
    namespace: "${DESKTOP_NAMESPACE}"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: personal-desktop-gateway
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: personal-desktop-gateway
  namespace: "${DESKTOP_NAMESPACE}"
  labels: &gatewayLabels
    app.kubernetes.io/name: personal-desktop-gateway
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/experimental: "true"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: personal-desktop-gateway
  template:
    metadata:
      labels: *gatewayLabels
    spec:
      serviceAccountName: personal-desktop-gateway
      containers:
        - name: gateway
          image: "${GATEWAY_IMAGE}"
          imagePullPolicy: IfNotPresent
          env:
            - name: DESKTOP_NAMESPACE
              value: "${DESKTOP_NAMESPACE}"
            - name: TYPECLAW_INSTANCE_UID
              value: "${TYPECLAW_INSTANCE_UID}"
            - name: ALLOW_INSECURE_DEV_AUTH
              value: "${ALLOW_INSECURE_DEV_AUTH}"
            - name: OWNER_HASH_KEY
              valueFrom:
                secretKeyRef:
                  name: personal-desktop-gateway-secrets
                  key: owner-hash-key
            - name: POC_AGENT_TOKEN_KEY
              valueFrom:
                secretKeyRef:
                  name: personal-desktop-gateway-secrets
                  key: agent-token-key
            - name: POC_AUTH_PROXY_TOKEN
              valueFrom:
                secretKeyRef:
                  name: personal-desktop-gateway-secrets
                  key: auth-proxy-token
            - name: POC_DEV_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: personal-desktop-gateway-secrets
                  key: dev-access-token
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 96Mi
            limits:
              cpu: 500m
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
---
apiVersion: v1
kind: Service
metadata:
  name: personal-desktop-gateway
  namespace: "${DESKTOP_NAMESPACE}"
  labels:
    app.kubernetes.io/name: personal-desktop-gateway
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/experimental: "true"
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: personal-desktop-gateway
  ports:
    - name: http
      port: 80
      targetPort: http
