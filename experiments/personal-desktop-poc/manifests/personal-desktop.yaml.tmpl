# The DataVolume deliberately lives outside spec.dataVolumeTemplates. It is not
# owned by the VirtualMachine, so stopping or deleting the VM cannot silently
# delete the user's whole-root disk.
apiVersion: cdi.kubevirt.io/v1beta1
kind: DataVolume
metadata:
  name: "${DESKTOP_NAME}-root"
  namespace: "${DESKTOP_NAMESPACE}"
  labels: &desktopLabels
    app.kubernetes.io/name: personal-desktop
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/desktop-owner-key: "${OWNER_KEY}"
    typeclaw.io/experimental: "true"
spec:
  source:
    pvc:
      name: "${GOLDEN_IMAGE_NAME}"
      namespace: "${DESKTOP_NAMESPACE}"
  storage:
    accessModes:
      - ReadWriteOnce
    resources:
      requests:
        storage: "${DESKTOP_DISK_SIZE}"
    storageClassName: "${STORAGE_CLASS}"
    volumeMode: Filesystem
---
# In-cluster ClusterIP that forwards the typed-action port to the VM's
# masquerade interface. The Gateway is the only intended caller; the agent
# authenticates it with the derived desktop-agent bearer.
apiVersion: v1
kind: Service
metadata:
  name: "${DESKTOP_NAME}-agent"
  namespace: "${DESKTOP_NAMESPACE}"
  labels:
    app.kubernetes.io/name: personal-desktop
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/desktop-owner-key: "${OWNER_KEY}"
    typeclaw.io/experimental: "true"
spec:
  selector:
    kubevirt.io/domain: "${DESKTOP_NAME}"
  ports:
    - name: desktop-agent
      protocol: TCP
      port: 9876
      targetPort: 9876
---
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: "${DESKTOP_NAME}"
  namespace: "${DESKTOP_NAMESPACE}"
  labels:
    app.kubernetes.io/name: personal-desktop
    app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
    typeclaw.io/desktop-owner-key: "${OWNER_KEY}"
    typeclaw.io/experimental: "true"
spec:
  runStrategy: Manual
  template:
    metadata:
      labels:
        app.kubernetes.io/name: personal-desktop
        app.kubernetes.io/part-of: typeclaw-personal-desktop-poc
        kubevirt.io/domain: "${DESKTOP_NAME}"
        typeclaw.io/desktop-owner-key: "${OWNER_KEY}"
        typeclaw.io/experimental: "true"
    spec:
      architecture: amd64
      nodeSelector:
        kubernetes.io/hostname: "${DESKTOP_NODE_NAME}"
      domain:
        cpu:
          cores: ${DESKTOP_CPU_CORES}
        devices:
          autoattachGraphicsDevice: true
          disks:
            - name: rootdisk
              disk:
                bus: virtio
            - name: cloudinit
              disk:
                bus: virtio
          inputs:
            - name: tablet
              type: tablet
              bus: usb
          interfaces:
            - name: default
              masquerade: {}
              # KubeVirt masquerade port forwarding: the Service below reaches
              # the guest desktop-agent only through this declared port.
              ports:
                - name: desktop-agent
                  protocol: TCP
                  port: 9876
        features:
          acpi: {}
        machine:
          type: q35
        resources:
          requests:
            memory: "${DESKTOP_MEMORY}"
      networks:
        - name: default
          pod: {}
      terminationGracePeriodSeconds: 90
      volumes:
        - name: rootdisk
          dataVolume:
            name: "${DESKTOP_NAME}-root"
        - name: cloudinit
          cloudInitNoCloud:
            userData: |
              #cloud-config
              hostname: "${DESKTOP_NAME}"
              manage_etc_hosts: true
              users:
                - default
                - name: desktop
                  gecos: Personal Desktop
                  # LightDM's PAM autologin profile requires this group for a
                  # password-locked account used by the PoC desktop.
                  groups: [adm, audio, cdrom, dialout, dip, floppy, nopasswdlogin, plugdev, sudo, video]
                  lock_passwd: true
                  ssh_authorized_keys:
                    - "${DESKTOP_SSH_AUTHORIZED_KEY}"
                  shell: /bin/bash
                  sudo: ALL=(ALL) NOPASSWD:ALL
              package_update: true
              package_upgrade: false
              packages:
                - dbus-x11
                - firefox
                - lightdm
                - qemu-guest-agent
                - scrot
                - wmctrl
                - xdotool
                - xfce4
                - xfce4-goodies
              write_files:
                - path: /etc/lightdm/lightdm.conf.d/50-personal-desktop.conf
                  permissions: "0644"
                  content: |
                    [Seat:*]
                    autologin-user=desktop
                    autologin-user-timeout=0
                    user-session=xfce
                    xserver-command=X -s 0 -dpms
                # The TypeClaw computer-use agent runs inside the XFCE session
                # (autostart below) so DISPLAY=:0 and the session keyring are
                # available. The Python source is injected by
                # scripts/render-personal-desktop.sh from
                # ../desktop-agent/desktop-agent.py.
                - path: /usr/local/bin/desktop-agent.py
                  owner: root:root
                  permissions: "0755"
                  content: |
__DESKTOP_AGENT_PYTHON__
                # WARNING: the derived token is readable by anyone who can
                # read this VM spec in the namespace. Acceptable PoC
                # exposure; production must deliver it through a Secret
                # mechanism, not cloud-init userData.
                - path: /etc/personal-desktop/agent-token
                  owner: desktop:desktop
                  permissions: "0600"
                  content: "${DESKTOP_AGENT_TOKEN}"
                - path: /home/desktop/.config/autostart/typeclaw-desktop-agent.desktop
                  owner: desktop:desktop
                  permissions: "0644"
                  content: |
                    [Desktop Entry]
                    Type=Application
                    Name=TypeClaw Desktop Agent
                    Comment=Typed computer-use actions for the TypeClaw agent
                    Exec=/usr/local/bin/desktop-agent.py
                    Terminal=false
              bootcmd:
                - [sh, -c, "echo 'lightdm shared/default-x-display-manager select lightdm' | debconf-set-selections"]
              runcmd:
                - [usermod, -aG, nopasswdlogin, desktop]
                - [systemctl, enable, qemu-guest-agent.service]
                - [systemctl, start, qemu-guest-agent.service]
                - [systemctl, set-default, graphical.target]
                - [systemctl, enable, lightdm.service]
              power_state:
                delay: now
                mode: reboot
                message: Reboot after first-boot XFCE installation
                condition: true
